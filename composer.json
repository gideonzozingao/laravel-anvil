{
    "$schema": "https://getcomposer.org/schema.json",
    "name": "zuqongtech/laravel-anvil",
    "description": "Full Laravel project scaffolding via live database introspection — models, controllers, form requests, services, repositories, gates, API routes, factories, seeders, migrations, events, observers, policies, and feature tests generated from your connected database.",
    "type": "library",
    "keywords": [
        "laravel",
        "laravel-anvil",
        "scaffold",
        "scaffolding",
        "code-generation",
        "database",
        "introspection",
        "eloquent",
        "factory",
        "seeder",
        "repository",
        "service",
        "boilerplate",
        "generator"
    ],
    "license": "MIT",
    "authors": [
        {
            "name": "Gideon Zozingao",
            "email": "gideongzozingao@gmail.com",
            "homepage": "https://github.com/gideonzozingao",
            "role": "Developer"
        }
    ],
    "require": {
        "php": "^8.3",
        "illuminate/bus": "^11.0|^12.0|^13.0",
        "illuminate/cache": "^11.0|^12.0|^13.0",
        "illuminate/collections": "^11.0|^12.0|^13.0",
        "illuminate/config": "^11.0|^12.0|^13.0",
        "illuminate/console": "^11.0|^12.0|^13.0",
        "illuminate/container": "^11.0|^12.0|^13.0",
        "illuminate/contracts": "^11.0|^12.0|^13.0",
        "illuminate/database": "^11.0|^12.0|^13.0",
        "illuminate/events": "^11.0|^12.0|^13.0",
        "illuminate/filesystem": "^11.0|^12.0|^13.0",
        "illuminate/http": "^11.0|^12.0|^13.0",
        "illuminate/queue": "^11.0|^12.0|^13.0",
        "illuminate/routing": "^11.0|^12.0|^13.0",
        "illuminate/support": "^11.0|^12.0|^13.0",
        "illuminate/translation": "^11.0|^12.0|^13.0",
        "illuminate/validation": "^11.0|^12.0|^13.0",
        "illuminate/view": "^11.0|^12.0|^13.0",
        "symfony/yaml": "^7.0|^8.0"
    },
    "require-dev": {
        "designsecurity/progpilot": "^1.3",
        "driftingly/rector-laravel": "^2.5",
        "fakerphp/faker": "^1.23",
        "icanhazstring/composer-unused": "^0.9",
        "laravel/pint": "^1.0",
        "maglnet/composer-require-checker": "^4.0",
        "mockery/mockery": "^1.6",
        "orchestra/testbench": "^9.0|^10.0|^11.0",
        "phpunit/phpunit": "^11.5.50|^12.5.8|^13.0",
        "rector/rector": "^2.4",
        "roave/security-advisories": "dev-latest"
    },
    "suggest": {
        "livewire/livewire": "Required by anvil:forge-webapp --stack=livewire and anvil:forge-auth (^3.0)",
        "nuwave/lighthouse": "Required by anvil:forge-graphql (^6.0)",
        "pragmarx/google2fa": "Required for two-factor authentication in anvil:forge-auth (^8.0)",
        "laravel/pint": "Enables the formatting pass in anvil:polish (^1.0)",
        "rector/rector": "Enables the modernisation pass in anvil:polish (^2.0)",
        "larastan/larastan": "Enables the static analysis pass in anvil:polish (^3.0)"
    },
    "autoload": {
        "psr-4": {
            "Zuqongtech\\LaravelAnvil\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Zuqongtech\\LaravelAnvil\\Tests\\": "tests/"
        }
    },
    "extra": {
        "laravel": {
            "providers": [
                "Zuqongtech\\LaravelAnvil\\LaravelAnvilServiceProvider"
            ]
        },
        "branch-alias": {
            "dev-main": "1.2.x-dev"
        }
    },
    "scripts": {
        "test": "vendor/bin/phpunit --colors=always",
        "test-coverage": "vendor/bin/phpunit --coverage-html coverage",
        "lint": "vendor/bin/pint",
        "lint-check": "vendor/bin/pint --test",
        "refactor": "vendor/bin/rector process",
        "refactor-dry": "vendor/bin/rector process --dry-run",
        "deps-check": [
            "vendor/bin/composer-require-checker",
            "vendor/bin/composer-unused"
        ],
        "check": [
            "@lint-check",
            "@refactor-dry",
            "@deps-check",
            "@test"
        ]
    },
    "config": {
        "optimize-autoloader": true,
        "preferred-install": "dist",
        "sort-packages": true,
        "allow-plugins": {
            "bamarni/composer-bin-plugin": true
        }
    },
    "archive": {
        "exclude": [
            "/.github",
            "/tests",
            "/workbench",
            "/vendor-bin",
            "/.rector_cache",
            "/.phpunit.cache",
            "/coverage",
            "phpunit.xml",
            "phpunit.xml.dist",
            "rector.php",
            ".pint.json",
            "CHANGELOG.md",
            "CONTRIBUTING.md"
        ]
    },
    "prefer-stable": true
}